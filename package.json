{
  "name": "jairocloud-groups-manager",
  "private": true,
  "type": "module",
  "version": "1.0.0-alpha.2",
  "description": "A web client for JAIRO Cloud repository administrators to manage groups in the GakuNin Cloud Gateway.",
  "license": "MIT",
  "author": {
    "name": "National Institute of Informatics"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "docs:dev": "pnpm -F docs dev",
    "docs:link-check": "pnpm -F docs link-check",
    "docs:generate": "pnpm -F docs generate",
    "check-updates": "pnpx --package=npm-check-updates ncu"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.126",
    "@nuxt/content": "^3.15.2",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@vueuse/nuxt": "^14.4.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "scule": "^1.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "4.1.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.9.1",
    "eslint-plugin-unicorn": "^73.0.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^24.16.0",
    "pnpm": "^12.0.0"
  },
  "packageManager": "pnpm@12.0.0"
}
